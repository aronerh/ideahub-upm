# Copy this file to .env.local and fill in the values from
# Supabase: Project Settings -> API (Project URL and publishable key).
# .env.local is gitignored; never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional, server-only (IH-42): emails an idea's author when an investor contacts the team.
# Leave empty and contact requests are still saved, just without the email.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
SUPABASE_SECRET_KEY=
